@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&display=swap");

body, .mw-body, .mw-body-content, p, li { font-family: sans-serif !important; }

h1, h2, h3, h4, h5, h6, .page-header__title, .portable-infobox .pi-header { font-family: Comfortaa, cursive !important; font-weight: 700; }

.wds-search-modal__input, .mw-ui-button, button { font-family: Comfortaa, cursive !important; }

.page-header__title { letter-spacing: -0.5px; text-align: center; }

.theme-fandomdesktop-light .page-content { border: 3px solid rgb(148, 39, 146); box-shadow: rgba(148, 39, 146, 0.3) 0px 0px 15px inset; border-radius: 15px; padding: 10px; background: rgba(255, 255, 255, 0.5); margin: 5px; }

.theme-fandomdesktop-dark .page-content { border: 3px solid rgb(115, 238, 220); box-shadow: rgba(115, 238, 220, 0.3) 0px 0px 15px inset; border-radius: 15px; padding: 10px; background: rgba(35, 11, 45, 0.6); margin: 5px; }

::-webkit-scrollbar { width: 8px; }

::-webkit-scrollbar-thumb { border-radius: 10px; background: linear-gradient(rgb(148, 39, 146), rgb(115, 238, 220)); }

::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.1); }

.portable-infobox { border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.3) 0px 5px 15px; border: 1px solid rgba(255, 255, 255, 0.2); overflow: hidden; width: 100% !important; margin: 0px 0px 20px !important; }

.theme-fandomdesktop-light .portable-infobox { background-color: rgb(255, 240, 245); border-color: rgb(238, 187, 208); }

.theme-fandomdesktop-dark .portable-infobox { background-color: rgba(35, 11, 45, 0.85); border-color: rgb(115, 238, 220); }

.portable-infobox .pi-header { text-transform: uppercase; letter-spacing: 1px; }

.wikia-gallery { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

.wikia-gallery-item { width: 48% !important; height: auto !important; margin: 0px !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: none !important; }

.wikia-gallery-item .thumb { height: 150px; overflow: hidden; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.2); }

.wikia-gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }

.wikia-gallery-item:active img { transform: scale(1.1); }

a { transition: 0.2s; }

a:active { opacity: 0.6; text-shadow: currentcolor 0px 0px 5px; }

.user-identity-avatar__image { transition: transform 0.6s; }

.user-identity-avatar__image:active { transform: rotate(360deg) scale(1.1); box-shadow: rgb(115, 238, 220) 0px 0px 15px; border-radius: 50%; }

::selection { background: rgb(115, 238, 220); color: rgb(0, 0, 0); }

.wds-search-modal__input { border-radius: 25px !important; }

body.main-page .mobile-main-page__wiki-description, body.main-page .mobile-main-page__trending-articles { display: none !important; }

blockquote { background: rgba(115, 238, 220, 0.1); margin: 10px 0px; padding: 10px 15px; border-radius: 0px 10px 10px 0px; font-family: Comfortaa, cursive; border-left: 4px solid rgb(115, 238, 220) !important; }

.cw-mobile-box, table.cw-mobile-box, div.cw-mobile-box { display: table !important; visibility: visible !important; width: 95% !important; max-width: 100% !important; margin: 15px auto !important; padding: 12px !important; border-collapse: separate !important; border-width: 1px 1px 1px 8px !important; border-style: solid !important; border-color: rgba(255, 140, 0, 0.4) rgba(255, 140, 0, 0.4) rgba(255, 140, 0, 0.4) rgb(255, 140, 0) !important; border-radius: 8px !important; box-sizing: border-box !important; }

.cw-mobile-box td, .cw-mobile-box div { display: block !important; padding: 5px 0px !important; }

.theme-fandomdesktop-light .cw-mobile-box { background-color: rgba(255, 165, 0, 0.12) !important; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 8px !important; }

.theme-fandomdesktop-dark .cw-mobile-box { background-color: rgba(45, 25, 10, 0.8) !important; box-shadow: rgba(0, 0, 0, 0.3) 0px 4px 12px !important; backdrop-filter: blur(4px) !important; }

.cw-mobile-box span { display: inline-block !important; margin-bottom: 5px !important; font-size: 1.1em !important; }
