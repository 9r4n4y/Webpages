@charset "utf-8";

.category-trending-pages__header { font-size: 18px; font-weight: 500; margin: 20px 0px; }

.category-page__total-number { font-size: 18px; font-weight: 500; margin-top: 30px; }

#mw-content-text ul.category-alphabet-shortcuts { display: flex; list-style: none; margin: 20px 0px 40px; overflow-x: scroll; }

.category-alphabet-shortcuts__item { background: rgba(var(--theme-border-color--rgb),.25); font-size: 14px; font-weight: 500; line-height: 14px; padding: 15px 17px; }

.category-alphabet-shortcuts__item:not(:last-child) { margin-right: 1px; }

.category-alphabet-shortcuts__item a { color: var(--theme-link-color); }

.category-alphabet-shortcuts__item.is-active { background: var(--theme-link-color); }

.category-alphabet-shortcuts__item.is-active a { color: var(--theme-border-color); }

.category-members-grouped { margin-top: 30px; padding: 0px 6px; }

.category-members-grouped h3.category-members-grouped__first-char { align-items: center; border-bottom: 1px solid var(--theme-border-color); display: flex; font-size: 24px; font-weight: 400; margin: 0px; padding-bottom: 10px; }

.category-members-grouped h3.category-members-grouped__first-char:not(:first-child) { margin-top: 40px; }

.category-members-grouped h3.category-members-grouped__first-char .chevron { margin-left: auto; }

.category-members-grouped h3.category-members-grouped__first-char:not(.is-collapsed) .chevron { transform: rotate(180deg); }

.category-members-grouped ul.category-members-grouped__members-for-char { margin: 0px; padding: 0px; position: relative; }

.is-collapsed + .category-members-grouped__members-for-char { display: none; }

.category-members-grouped__member { align-items: center; display: flex; margin: 0px; padding: 9px 0px; }

.category-members-grouped__member-left { display: flex; flex-shrink: 0; justify-content: center; width: 30px; }

.category-members-grouped__member-left-icon { padding: 6px 0px; }

.category-members-grouped__member-thumbnail { border: 1px solid var(--theme-border-color); border-radius: 3px; box-sizing: border-box; height: 30px; width: 30px; }

.category-members-grouped__member-link { overflow-wrap: break-word; padding-left: 12px; }

.category-members-grouped .category-members-grouped__member-link { color: inherit; }

.category-pagination { border-top: 1px solid var(--theme-border-color); display: flex; justify-content: space-between; margin-bottom: 40px; margin-top: 10px; padding-top: 20px; }

.category-pagination__prev.wds-button { margin-right: auto; }

.category-pagination__prev.wds-button .wds-icon { transform: rotate(90deg); }

.category-pagination__next.wds-button { margin-left: auto; }

.category-pagination__next.wds-button .wds-icon { transform: rotate(-90deg); }

.trfc-147 { border: 1px solid var(--theme-border-color); }

.skin-fandommobile .trfc-147 { margin-bottom: 7px; }

.trfc-147__header { color: var(--theme-page-text-color); background-color: var(--theme-border-color); font-size: 16px; font-weight: bold; padding: 5px 10px; }

.trfc-147__content { padding: 10px 10px 20px 5px; }

.trfc-147__list li:last-child { border-right: 1px solid transparent; }

.trfc-147__item { font-size: 14px; display: inline; border-right: 1px solid var(--theme-border-color); padding: 7px; }

.theme-fandommobile-light, body[data-theme="light"] { --community-bar-button-background-color: #ffffffe6; }

.theme-fandommobile-dark, body[data-theme="dark"] { --community-bar-button-background-color: #000000e6; }

.mobile-community-bar { background-color: var(--fandom-global-nav-mobile-community-bar-background-color); border-top: 1px solid rgba(var(--theme-border-color--rgb),.25); position: relative; }

.mobile-community-bar--with-background::after, .mobile-community-bar--with-background::before { content: ""; position: absolute; width: 100%; z-index: -2; }

.mobile-community-bar--with-background::before { background-image: var(--theme-body-background-image); background-repeat: no-repeat; background-size: cover; height: 220px; opacity: 0.4; top: 56px; }

