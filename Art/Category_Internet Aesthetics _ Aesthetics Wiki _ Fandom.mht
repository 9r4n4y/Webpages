.mobile-community-bar__sitename { align-items: flex-start; background-color: initial; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; display: flex; flex: 1 1 0%; flex-direction: column; gap: 3px; justify-content: center; line-height: 1; margin-left: 3px; min-width: 0px; }

.mobile-community-bar__sitename__article-name, .mobile-community-bar__sitename__community-name { color: var(--fandom-global-nav-mobile-community-bar-color); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

