  .tocnumber, .toctext { display: table-cell; text-decoration: inherit; }
  .tocnumber { color: rgb(34, 34, 34); }
  .toctogglecheckbox { position: absolute; opacity: 0; z-index: -1; display: inline !important; }
  .toctogglespan { font-size: 94%; }
  .toctogglespan::before { content: " ["; }
  .toctogglespan::after { content: "]"; }
  .toctogglelabel { color: rgb(6, 69, 173); cursor: pointer; }
  .toctogglelabel:hover { text-decoration: underline; }
  .toctogglecheckbox:focus + .toctitle .toctogglelabel { text-decoration: underline; outline: auto; }
  .toctogglecheckbox:checked + .toctitle .toctogglelabel::after { content: "show"; }
  .toctogglecheckbox:not(:checked) + .toctitle .toctogglelabel::after { content: "hide"; }
}

@media print {
  figure[typeof~="mw:File/Thumb"], figure[typeof~="mw:File/Frame"] { border-width: 1pt 1pt 0px; border-style: none; border-color: currentcolor; border-image: none; background-color: rgb(255, 255, 255); }
  figure[typeof~="mw:File/Thumb"] > :not(figcaption) .mw-file-element, figure[typeof~="mw:File/Frame"] > :not(figcaption) .mw-file-element { border: 1pt solid rgb(221, 221, 221); }
  figure[typeof~="mw:File/Thumb"] > figcaption, figure[typeof~="mw:File/Frame"] > figcaption { background-color: rgb(255, 255, 255); color: rgb(102, 102, 102); font-size: 10pt; border-width: 0px 1pt 1pt; border-style: none; border-color: currentcolor; border-image: none; }
  .mw-image-border .mw-file-element { border: 1pt; }
  .mw-parser-output a.external { }
  .mw-parser-output a.external.text::after, .mw-parser-output a.external.autonumber::after { content: ' (' attr(href) ')'; word-break: break-all; overflow-wrap: break-word; }
  .mw-parser-output a.external.text[href^="//"]::after, .mw-parser-output a.external.autonumber[href^="//"]::after { content: ' (https:' attr(href) ')'; }
  .wikitable { background: rgb(255, 255, 255); margin: 1em 0px; border: 1pt solid rgb(170, 170, 170); border-collapse: collapse; font-size: 10pt; break-inside: avoid; }
  .wikitable > caption { padding: 5px; font-size: 10pt; }
  .wikitable > tr > th, .wikitable > tr > td, .wikitable > * > tr > th, .wikitable > * > tr > td { border: 1pt solid rgb(170, 170, 170); padding: 0.4em 0.6em; background: rgb(255, 255, 255) !important; color: rgb(0, 0, 0) !important; }
  .wikitable > tr > th, .wikitable > * > tr > th { text-align: center; }
  table.listing, table.listing td { border: 1pt solid rgb(0, 0, 0); border-collapse: collapse; }
  .mw-editsection, .mw-editsection-like, .mw-indicators, #siteNotice, .usermessage { display: none; }
  .printfooter { clear: both; padding: 1em 0px; }
  .toctogglecheckbox:checked + .toctitle { display: none; }
  .toc { background-color: rgb(249, 249, 249); border: 1pt solid rgb(170, 170, 170); padding: 5px; display: table; }
  .tocnumber, .toctext { display: table-cell; }
}

